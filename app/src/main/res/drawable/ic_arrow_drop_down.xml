<?xml version="1.0" encoding="utf-8"?>
<!--
  The caret on the plan button (Version 18): "there is a list behind this".

  A filled triangle rather than a thin chevron, because the button opens a menu of plans to choose between
  rather than pushing a screen - the same shape the rest of Android uses for exactly that.

  Tinted by the button that uses it, like ic_add_link.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FF000000"
        android:pathData="M7,10l5,5 5,-5z" />
</vector>
