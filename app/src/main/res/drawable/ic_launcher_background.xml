<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher icon's background (Phase 10.3).

  A solid brand blue, matching `splash_background` and `md_primary` (#1565C0). This replaced the Android
  Studio template's green (#3DDC84) with its construction grid - the icon a new project ships with, which
  says nothing about the app and is the first thing a user sees.

  A flat fill rather than a gradient: the adaptive icon is masked into a shape by the launcher, and a
  gradient would be cropped differently on every device, so its direction would be arbitrary.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#1565C0"
        android:pathData="M0,0h108v108h-108z" />
</vector>
