<?xml version="1.0" encoding="utf-8"?>
<!--
  A COMPLETED store: a green teardrop pin containing a check mark.

  36dp, matching the pending pin, so the two read as the same family at any zoom.

  THE SHAPE IS THE POINT. Orange and green are the classic red/green-confusion pair, so a user who cannot
  separate them would see two identical pins. This one carries a check; the pending pin carries a filled
  circle. Colour is never the only signal (Phase 0.3 s13.15), and MapMarkerControllerTest asserts that the
  two statuses can never resolve to the same drawable.

  The check is drawn as a stroked path rather than a filled glyph: scaling a filled Material icon down to
  fit inside the teardrop's circle thins its strokes to a hairline, whereas a stroked path keeps a
  constant, readable weight.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="36dp"
    android:height="36dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="@color/marker_completed"
        android:pathData="M12,2C8.13,2 5,5.13 5,9c0,5.25 7,13 7,13s7,-7.75 7,-13C19,5.13 15.87,2 12,2z" />
    <path
        android:fillColor="#00000000"
        android:pathData="M9.9,9.1 l1.5,1.5 l2.8,-2.8"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="1.6" />
</vector>
