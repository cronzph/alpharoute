<?xml version="1.0" encoding="utf-8"?>
<!--
  The application shell (architecture decision AD-1: one Activity, many Fragments).

    toolbar            - shows the title of the active tab
    fragment_container - hosts whichever tab Fragment is currently shown
    bottom_nav         - the four top-level destinations

  Tab switching is done with FragmentManager add/show/hide transactions in MainActivity, NOT with the
  Navigation Component, so there is no navigation graph file in this project.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.AlphaRoute.Toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/title_dashboard" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <!--
      The bottom navigation bar (Version 11).

      Chrome, like the toolbar - and for the same reason, see Widget.AlphaRoute.Toolbar.

      There was a fade here too, and it is gone. The list scrolls underneath this bar, and at anything less
      than near-opaque the rows showed through it.

      app:elevation is 0dp because Material's default elevation draws a shadow AND applies an elevation
      tint, which would grey the translucent fill and make the bar look like a solid slab.
    -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/glass_chrome"
        app:elevation="0dp"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/menu_bottom_nav" />

</androidx.constraintlayout.widget.ConstraintLayout>