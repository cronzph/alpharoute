<?xml version="1.0" encoding="utf-8"?>
<!--
  Map screen (Phase 3.1, extended in 3.2).

  ONE banner, not three. Permission, location-services and connectivity problems are all "something is
  stopping the map from being useful", they can overlap, and stacking three cards over a map would cover
  it. So there is a single card whose message and action button change with the situation, and
  MapFragment decides which problem has priority. See MapFragment.BannerState.

  Still NOT here, and deliberately:
    - no store markers          -> Phase 3.4
    - no Home marker            -> Phase 3.7
    - no route polyline         -> Phase 4.2
    - no add-store form         -> Phase 3.3

  The attribution is a plain TextView pinned to the bottom-right of the map area rather than osmdroid's
  CopyrightOverlay, so it is guaranteed to be on screen at all times. The OpenStreetMap tile policy
  requires the attribution to be visible and explicitly forbids hiding it behind other UI - which is why
  the "My location" button sits above it rather than on top of it.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    tools:context=".ui.map.MapFragment">

    <org.osmdroid.views.MapView
        android:id="@+id/map_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Loading: visible until the map surface has been laid out. Tiles then fill in progressively. -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/map_loading"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
      The single banner. Message and action both change with the state, so the layout has one place to
      look and MapFragment has one place to reason about.
    -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_map_banner"
        style="@style/Widget.AlphaRoute.StatCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/glass_fill_accent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/map_loading"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tv_map_banner_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.AlphaRoute.Caption"
                android:textColor="?attr/colorOnSurface"
                tools:text="Alfamart Route Tracker needs your location to show where you are on the map." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_map_banner_action"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="@string/map_action_allow_location" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!--
      Transient status: "Waiting for GPS…", or the current accuracy once a fix arrives. Sits above the
      attribution so it never covers it.
    -->
    <TextView
        android:id="@+id/tv_map_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="48dp"
        android:background="@color/map_attribution_scrim"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:textAppearance="@style/TextAppearance.AlphaRoute.Caption"
        android:textColor="@color/map_attribution_text"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Waiting for GPS…"
        tools:visibility="visible" />

    <!--
      Phase 4.3 - the active navigation bar.

      A compact, always-visible strip while a drive is in progress. It exists because the Navigation Active
      sheet is dismissable: without this, closing the sheet would leave a session running with nothing on
      screen to say so and no way back to it except the notification.

      It sits at the TOP of the map, under the banner, and deliberately not at the bottom: the
      OpenStreetMap attribution is pinned to the bottom and the tile policy forbids covering it.

      Gone entirely when no session is running - it is not a control that is always there, so an empty bar
      would be a permanent piece of furniture describing nothing.
    -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_nav_bar"
        style="@style/Widget.AlphaRoute.StatCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorPrimaryContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_map_banner"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="8dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tv_nav_bar_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.AlphaRoute.ListSubtitle"
                android:textColor="?attr/colorOnPrimaryContainer"
                tools:text="Navigating to R-01 — 123456" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_nav_bar_open"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:text="@string/nav_bar_action_open" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!--
      Two map controls, stacked. The link button is the newer way to add a store: paste a location out of
      Google Maps rather than long-press and pin by eye. It sits above the My location button so the two
      can never overlap, and both sit above the attribution - which the tile policy requires to stay
      visible and explicitly forbids covering.
    -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_from_link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:contentDescription="@string/map_action_add_from_link"
        app:layout_constraintBottom_toTopOf="@id/fab_my_location"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/ic_add_link" />

    <!--
      Centres the map on the last known position ONCE. The camera is never continuously forced to follow
      the user - that is a requirement of this phase, not a preference.
    -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_my_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="48dp"
        android:contentDescription="@string/map_action_my_location"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/ic_my_location" />

    <!-- Required by the OpenStreetMap tile usage policy. Never hide this. -->
    <TextView
        android:id="@+id/tv_map_attribution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="6dp"
        android:background="@color/map_attribution_scrim"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:textAppearance="@style/TextAppearance.AlphaRoute.Caption"
        android:textColor="@color/map_attribution_text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="© OpenStreetMap contributors" />

</androidx.constraintlayout.widget.ConstraintLayout>
