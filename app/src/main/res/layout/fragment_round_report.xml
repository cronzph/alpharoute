<?xml version="1.0" encoding="utf-8"?>
<!--
  The round report (Phase 12).

  Answers what no other screen could: how a round went. The History tab shows a day; this shows a whole
  pass over every store - how many stores, over how many days, and how the work was spread across them.

  The root is transparent and the cards are glass, like every screen since Version 11.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:fillViewport="true"
    tools:context=".ui.history.RoundReportFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/rounds_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rounds_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            tools:listitem="@layout/item_round_report" />

        <!-- Shown only when no round has any work in it. -->
        <TextView
            android:id="@+id/tv_rounds_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/rounds_empty"
            android:textAppearance="@style/TextAppearance.AlphaRoute.ListSubtitle"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
