<?xml version="1.0" encoding="utf-8"?>
<!--
  One date group on the History screen (Phase 6.2).

  A single line - "25 Sep 2026 · 3 stores" - rather than a date with the count underneath. The count is
  what makes the day worth opening, and putting both on one line means the whole list can be scanned
  without the eye having to move vertically.

  The whole card is the tap target, not just the text, so it behaves the way a list row is expected to.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.AlphaRoute.StatCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_history_day"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.AlphaRoute.ListTitle"
            tools:text="25 Sep 2026 · 3 stores" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_nav_history"
            app:tint="?attr/colorPrimary" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
